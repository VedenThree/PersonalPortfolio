{
  // I test girano con `node --test`, non con il bundler di Next. Node risolve
  // i moduli ESM per estensione esplicita, quindi servono gli import con
  // il suffisso `.ts` — cosa che il tsconfig principale non può permettere,
  // perché lì `allowImportingTsExtensions` non è un'opzione sensata.
  //
  // `allowImportingTsExtensions` è lecito solo perché `noEmit` è true: i test
  // non vengono mai compilati, li esegue Node con il type stripping.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.test.ts"],
  "exclude": []
}